{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memoriesmystory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/shared/*",
      "/resources/*",
      "/api/*",
      "/mcp",
      "/health",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  // Daily integrity (fixity) pass over stored files; see worker/fixity.ts.
  "triggers": { "crons": ["37 7 * * *"] },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "memoriesmystory",
    "PUBLIC_BRAND_NAME": "Memories: My Story",
    "LEGACY_REMOTE_RECORDING_ENABLED": "false"
  },
  "durable_objects": { "bindings": [{ "name": "LEGACY_RECORDERS", "class_name": "LegacyRecorder" }] },
  "migrations": [{ "tag": "v1-legacy-recorder", "new_sqlite_classes": ["LegacyRecorder"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memoriesmystory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "memoriesmystory-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Abuse limits per client address and Cloudflare location (worker/rate-limit.ts).
  // Periods may only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "REQUEST_LIMIT_PUBLIC", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "REQUEST_LIMIT_COSTLY", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "REQUEST_LIMIT_WRITES", "namespace_id": "4103", "simple": { "limit": 300, "period": 60 } }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "memoriesmystory-processing"
      }
    ],
    "consumers": [
      {
        "queue": "memoriesmystory-processing",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }

  // run_worker_first lists every Worker-served path. Without it, browser
  // navigations (family share links, API URLs) receive the app shell instead.
  // Add any new Worker route prefix to that list.
  // The zero D1 ID is an explicit non-deployable placeholder for local migration
  // tests. Replace it only in an authorized staging environment.
  // D1/R2/Queue resources are provisioned separately per environment.
  // AI and Queue binding names are frozen for the Living Memory proof.
}
