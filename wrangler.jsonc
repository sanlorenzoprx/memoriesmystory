{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memoriesmystory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "memoriesmystory",
    "PUBLIC_BRAND_NAME": "Memories: My Story"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memoriesmystory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "memoriesmystory-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "memoriesmystory-processing"
      }
    ],
    "consumers": [
      {
        "queue": "memoriesmystory-processing",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }

  // The zero D1 ID is an explicit non-deployable placeholder for local migration
  // tests. Replace it only in an authorized staging environment.
  // D1/R2/Queue resources are provisioned separately per environment.
  // AI and Queue binding names are frozen for the Living Memory proof.
}
