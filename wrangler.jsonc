{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memoriesmystory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "memoriesmystory",
    "PUBLIC_BRAND_NAME": "Memories: My Story"
  }

  // Provisioned Cloudflare resources are intentionally not bound in Packet 0.
  // Add D1, R2, Queue, and Durable Object bindings only after Packet 1 creates
  // the first real persistence contracts and deployment receipts.
}
