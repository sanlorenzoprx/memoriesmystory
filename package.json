{
  "name": "memoriesmystory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Memories: My Story Cloudflare-native web application.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "dev:e2e": "npm run build && wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e && wrangler dev --local --ip 127.0.0.1 --port 4173 --persist-to .wrangler/e2e --show-interactive-dev-session false",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:schema": "node --disable-warning=ExperimentalWarning scripts/verify-d1-schema.mjs",
    "test:e2e": "playwright test",
    "preflight:identity:staging": "node --env-file-if-exists=.env.staging.local scripts/preflight-identity-staging.mjs",
    "preflight:stripe:staging": "node --env-file-if-exists=.env.staging.local scripts/preflight-stripe-staging.mjs",
    "verify:core": "npm run typecheck && npm run lint && npm test && npm run test:schema && npm run build && npm run deploy:dry-run",
    "verify": "npm run verify:core && npm run test:e2e",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.6",
    "@clerk/clerk-react": "^5.61.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
