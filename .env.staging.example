# Set these to true only after the paths are enabled in the isolated Clerk application.
# Facebook may remain false only for an owner-approved interim staging run; it then
# reports deferred and remains a final acceptance blocker. Live tests—not these
# declarations—are the acceptance evidence.
CLERK_EMAIL_ENABLED=false
CLERK_GOOGLE_ENABLED=false
CLERK_FACEBOOK_ENABLED=false
